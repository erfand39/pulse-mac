{
  "name": "pulse-mac",
  "version": "1.0.20-mac.1",
  "description": "Local download manager for Apple Silicon Macs",
  "main": "./out/main/index.js",
  "author": "TheGreatAzizi",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev:mac": "electron-vite dev",
    "build:mac": "electron-vite build",
    "dist:mac:arm64": "npm run build:mac && node scripts/dist-mac.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src tests && git diff --check",
    "test": "tsx --tsconfig tsconfig.node.json --test tests/*.test.ts"
  },
  "dependencies": {
    "fs-chunk-store": "5.0.1",
    "undici": "7.30.2",
    "webtorrent": "^3.0.21",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "9.39.5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "local.pulse.personal.mac",
    "productName": "Pulse Mac",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/prebuilds/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "LICENSE",
      "NOTICE"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/menubarTemplate.png",
        "to": "menubarTemplate.png"
      },
      {
        "from": "resources/menubarTemplate@2x.png",
        "to": "menubarTemplate@2x.png"
      }
    ],
    "mac": {
      "icon": "icon.icns",
      "minimumSystemVersion": "13.0",
      "artifactName": "Pulse-Mac-${version}-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "bundleShortVersion": "1.0.20"
    },
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent metainfo",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "afterPack": "scripts/prune-native.cjs",
    "buildVersion": "1.0.20"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
